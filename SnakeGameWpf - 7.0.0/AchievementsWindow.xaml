<Window x:Class="SnakeGame.AchievementsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="成就" Width="640" Height="600"
        WindowStartupLocation="CenterOwner"
        FontFamily="Microsoft YaHei" Background="#F5F5F7">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock Text="成就" FontSize="26" FontWeight="Bold" Foreground="#161616"
                   Grid.Row="0" Margin="0,0,0,12"/>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="AchList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="White" BorderBrush="#DDDDDD" BorderThickness="1"
                                CornerRadius="6" Padding="14" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="Bold"
                                               Foreground="#161616"/>
                                    <TextBlock Text="{Binding Description}" FontSize="13"
                                               Foreground="#606060" Margin="0,4,0,0"/>
                                </StackPanel>
                                <TextBlock Text="{Binding Icon}" Grid.Column="1" FontSize="22"
                                           Foreground="{Binding IconBrush}"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Window>