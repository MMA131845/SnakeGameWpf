<Window x:Class="SnakeGame.RankingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="历史排行榜" Width="600" Height="600"
        WindowStartupLocation="CenterOwner"
        FontFamily="Microsoft YaHei" Background="#F5F5F7">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock Text="淘汰之王历史排行榜" FontSize="26" FontWeight="Bold"
                   Foreground="#161616" Grid.Row="0" Margin="0,0,0,12"/>
        <ListView x:Name="RankList" Grid.Row="1" BorderBrush="#DDDDDD" BorderThickness="1"
                  Background="White" FontSize="15">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="#" Width="60" DisplayMemberBinding="{Binding Rank}"/>
                    <GridViewColumn Header="玩家" Width="240" DisplayMemberBinding="{Binding Name}"/>
                    <GridViewColumn Header="分数" Width="180" DisplayMemberBinding="{Binding Score}"/>
                </GridView>
            </ListView.View>
        </ListView>
    </Grid>
</Window>