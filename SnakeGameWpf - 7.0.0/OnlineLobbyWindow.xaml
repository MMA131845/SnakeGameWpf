<Window x:Class="SnakeGame.OnlineLobbyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="局域网联机" Width="420" Height="320"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        FontFamily="Microsoft YaHei" Background="#F5F5F7">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="选择联机方式" FontSize="20" FontWeight="Bold"
                   Foreground="#161616" Margin="0,0,0,16"/>

        <RadioButton x:Name="RbHost" Grid.Row="1" Content="创建房间（作为主机）"
                     IsChecked="True" FontSize="14" Margin="0,6,0,6"/>
        <RadioButton x:Name="RbJoin" Grid.Row="2" Content="加入房间"
                     FontSize="14" Margin="0,6,0,6"
                     Checked="RbJoin_Checked"/>

        <StackPanel x:Name="JoinPanel" Grid.Row="3" Orientation="Horizontal"
                    Margin="0,8,0,8" Visibility="Collapsed">
            <TextBlock Text="服务器 IP:" VerticalAlignment="Center" Width="90"/>
            <TextBox x:Name="IpBox" Width="180" Height="28" Text="127.0.0.1"/>
        </StackPanel>

        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,8,0,8">
            <TextBlock Text="端口:" VerticalAlignment="Center" Width="90"/>
            <TextBox x:Name="PortBox" Width="90" Height="28" Text="8888"/>
        </StackPanel>

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="CancelBtn" Content="取消" Width="90" Height="32" Margin="0,0,8,0"
                    Click="CancelBtn_Click"/>
            <Button x:Name="OkBtn" Content="确定" Width="90" Height="32"
                    Background="#0067C0" Foreground="White" BorderThickness="0"
                    Click="OkBtn_Click"/>
        </StackPanel>
    </Grid>
</Window>